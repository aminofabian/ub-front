# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment and local secrets (commit only *.example templates)
.env
.env.*
!.env.example
!.env.*.example
.envrc
.direnv/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large desktop / mobile installers exceed GitHub's 100 MB limit.
# Stage them locally with `bun run pack:desktop-downloads` /
# `bun run pack:mobile-downloads`, then host via GitHub Releases / CDN.
# Keep `manifest.json` (and small stub DMGs under the limit) in git.
public/downloads/desktop/*.exe
public/downloads/desktop/*.msi
public/downloads/desktop/*.AppImage
public/downloads/desktop/*.deb
public/downloads/mobile/*.apk
public/downloads/mobile/*.aab

# Local desktop-packaging backup tree — never commit
/.desktop-build-stash/
